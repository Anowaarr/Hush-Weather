{
  "name": "aether-weather",
  "private": true,
  "version": "1.0.0",
  "description": "An elegant, iOS-inspired weather web application built with React, TypeScript, and Open-Meteo API.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
